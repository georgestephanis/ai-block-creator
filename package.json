{
  "name": "ai-block-creator",
  "version": "1.0.0",
  "description": "Speak it, type it, or screenshot it into existence. AI custom block creator for WordPress Block Editor.",
  "main": "build/index.js",
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "lint-js": "wp-scripts lint-js src",
    "lint-js:fix": "wp-scripts lint-js src --fix",
    "lint-css": "wp-scripts lint-style src/**/*.scss",
    "lint-css:fix": "wp-scripts lint-style src/**/*.scss --fix",
    "format": "wp-scripts format src",
    "test": "npm run lint-js && npm run lint-css"
  },
  "keywords": [
    "wordpress",
    "gutenberg",
    "ai",
    "blocks"
  ],
  "author": "George Stephanis",
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@wordpress/scripts": "^30.0.0"
  },
  "dependencies": {
    "@wordpress/escape-html": "^3.0.0",
    "@wordpress/i18n": "^6.0.0",
    "@wordpress/icons": "^15.5.0"
  },
  "overrides": {
    "typescript": "5.6.3"
  }
}
